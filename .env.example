# Truthlabel MVP currently does not require private API keys for core scanning.
# Public flags and public endpoint/base-URL overrides can be set here when needed.

NEXT_PUBLIC_DEPLOYMENT_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_BUILD_DATE=YYYY-MM-DD
NEXT_PUBLIC_DEFAULT_REGION=UNKNOWN
NEXT_PUBLIC_OPEN_FOOD_FACTS_API_BASE_URL=https://world.openfoodfacts.org/api/v2
NEXT_PUBLIC_EXTERNAL_SAFETY_ROUTE_PATH=/api/external-safety
NEXT_PUBLIC_ANALYTICS_ROUTE_PATH=/api/analytics/events
NEXT_PUBLIC_OCR_LANGUAGE=eng
NEXT_PUBLIC_SUPPORT_EMAIL=support@truthlabel.app

# Paid access setup. These are public/browser-readable placeholders only.
# Do not put Supabase secret/service-role keys or Gumroad private tokens here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_GUMROAD_CHECKOUT_URL=https://truthlabel.gumroad.com/l/fnoakd?wanted=true
NEXT_PUBLIC_GUMROAD_MANAGE_SUBSCRIPTION_URL=https://gumroad.com/library

NEXT_PUBLIC_ENABLE_BARCODE_LOOKUP=true
NEXT_PUBLIC_ENABLE_CAMERA_BARCODE_SCAN=true
NEXT_PUBLIC_ENABLE_OCR_SCAN=true
NEXT_PUBLIC_ENABLE_EXTERNAL_SAFETY_LOOKUP=true
NEXT_PUBLIC_ENABLE_DEMO_PRODUCTS=true
NEXT_PUBLIC_ENABLE_TEST_FEEDBACK=true
NEXT_PUBLIC_ENABLE_DEBUG_OUTPUT=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_INTERNAL_ANALYTICS_DASHBOARD=false

# Better Picks coming-soon configuration. These values are safe to expose because
# they only control public launch messaging, not private recommendation data.
NEXT_PUBLIC_BETTER_PICKS_LAUNCH_AT=2026-08-08T14:30:00+02:00
NEXT_PUBLIC_BETTER_PICKS_ENABLED=false
NEXT_PUBLIC_BETTER_PICKS_REMINDER_ENABLED=true

# Temporary MVP access mode. When true, any successfully signed-in account can
# use the app while paid activation matching is being hardened.
NEXT_PUBLIC_ENABLE_SIGNED_IN_MVP_ACCESS=true

# Development only. Ignored in production builds even if set.
NEXT_PUBLIC_ENABLE_LOCAL_DEV_BYPASS=true

# Future server-only variables for Gumroad verification.
# Keep these in Vercel/Supabase server-side secret settings only, never in frontend code.
GUMROAD_PRODUCT_ID=YOUR_GUMROAD_PRODUCT_ID
GUMROAD_PRODUCT_PERMALINK=fnoakd
GUMROAD_ACCESS_TOKEN=YOUR_GUMROAD_ACCESS_TOKEN_OPTIONAL_FOR_FUTURE_SYNC
LICENSE_HASH_SECRET=replace-with-a-long-random-server-secret
GUMROAD_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Supabase Edge Function secret. Do not expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Temporary MVP activation link code for early users.
# Set this only in Supabase Edge Function secrets.
# Primary customer return/receipt activation link:
# https://truthlabel.vercel.app/activate?mvp_access=YOUR_CODE
# Gumroad purchase ping is backup only; the activation link should be the main
# customer activation path during MVP.
TRUTHLABEL_MVP_ACCESS_CODE=replace-with-a-temporary-private-code
TRUTHLABEL_ALLOW_MVP_DIRECT_ACTIVATION=true

# Server-only admin list for the private analytics dashboard.
# Comma-separated emails, for example: owner@example.com,team@example.com
TRUTHLABEL_ADMIN_EMAILS=owner@example.com
